# Copia este archivo como .env.local y rellena los valores.
# NO uses el prefijo NEXT_PUBLIC_: estas variables solo deben existir en el servidor.

# URL del proyecto (Project Settings → API / Data API), p. ej. https://xxxx.supabase.co
SUPABASE_URL=

# Clave secreta (sb_secret_...) o, en proyectos antiguos, la clave service_role.
# Omite RLS: no la compartas, no la subas al repositorio y no la expongas al navegador.
SUPABASE_SECRET_KEY=

# La app no tiene autenticación. En producción (next start) los endpoints de
# Supabase se bloquean salvo que pongas true aquí. Desaconsejado: añade
# autenticación antes de publicar.
# ETL_PERMITIR_SIN_AUTENTICACION=false

# Clave de MapTiler (https://cloud.maptiler.com/account/keys/). Lleva NEXT_PUBLIC_
# porque el mapa la usa en el navegador: restríngela a tus dominios en MapTiler.
NEXT_PUBLIC_MAPTILER_KEY=
